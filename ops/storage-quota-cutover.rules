rules_version = '2';

// CANDIDATE ONLY: activate after distributed iPhone builds use /api/handoffs.
// The runtime service account writes via IAM after reserving quota. Public
// clients can only read captures; they cannot bypass admission or edit its ledger.
service firebase.storage {
  match /b/{bucket}/o {
    match /inbox/{file} {
      allow read: if file.matches('[A-Z2-9]{8}\\.json');
      allow write: if false;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
